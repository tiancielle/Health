# Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=Health_DataBase
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# DATABASE_URL (obligatoire pour Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/Health_DataBase?schema=public&sslmode=prefer

# MongoDB Database
MONGODB_URI=mongodb://localhost:27017/health_system

# JWT Configuration (⚠️ un seul JWT_SECRET)
JWT_SECRET=ton-super-secret-jwt-2025
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Autres configurations...
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads